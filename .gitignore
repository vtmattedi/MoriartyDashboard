.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Secrets. creds.h carries the WiFi password, the MQTT broker password and the
# broker's root CA -- it must never be committed. include/creds.example.h is the
# template to copy; keep it in sync when adding a define.
/include/creds.h
/include/Creds

# Generated by src/Version/script.py on every build.
/include/Version.h

# Generated by PlatformIO from sdkconfig.defaults, which is source and stays
# tracked.
/sdkconfig
/sdkconfig.*
!/sdkconfig.defaults

# Fetched by the IDF component manager, if a managed component is ever added.
/managed_components

# Local agent configuration, not project source.
/.claude

# Transient markers written and removed by src/Version/script.py during a build.
# src/Version/version itself is tracked -- it is the version, not a build artifact.
/src/Version/.version_no_increment*
